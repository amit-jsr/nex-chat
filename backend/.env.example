# Copy to backend/.env and adjust as needed.

DATABASE_URL=postgresql+asyncpg://nxtchat:nxtchat@localhost:5432/nxtchat
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
MAX_RESPONSE_TOKENS=2048

# Phase 2 — budgeted context window
RECENT_BUDGET=8000
SUMMARY_BUDGET=1500
SYSTEM_PROMPT_BUDGET=500
FACTS_BUDGET=500

# Phase 3 — rolling summarization
COMPRESS_TRIGGER=0.7
KEEP_VERBATIM=8
COMPRESS_CHUNK_SIZE=15
REGEN_EVERY_N_VERSIONS=5
UTILITY_MODEL=gpt-4o-mini

# Phase 4 — fact memory
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
FACT_TOP_K=5
FACT_SIM_FLOOR=0.35
DEDUP_THRESHOLD=0.9
FACT_LLM_CHECK_FLOOR=0.75
FACT_CONFIDENCE_FLOOR=0.5
